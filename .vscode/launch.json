{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Qt + LLDB Debug",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/draft", // Replace with your executable name
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/opt/Qt/6.7.3/gcc_64/lib:${env:LD_LIBRARY_PATH}"
                }
            ]
        }
    ]
}